# ==============================================================================
# AuraPulse AI - Root .gitignore
# Covers Next.js 15, FastAPI (Python), Cloud Run/GCP, OS & IDE Artifacts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
/downloads/
eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Testing & Quality Assurance
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Next.js (Frontend)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Next.js build output
.next/
*/.next/
out/
*/out/
.vercel
test-results/
playwright-report/

# TypeScript build output
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Environment Variables, Secrets & GCP Credentials
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
*.env
# Ensure example file remains tracked
!.env.example

# Service account keys and Google application credentials
*service_account*.json
*credentials*.json
client_secret*.json
*.pem
*.key

# ------------------------------------------------------------------------------
# 5. Operating System Artifacts (macOS / Windows / Linux)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Linux / Vim / Emacs swap and backup files
*~
*.swp
*.swo
*.bak

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 8. Demo Video Production & Submission Media Artifacts
# ------------------------------------------------------------------------------
video_production/
docs/submission/demo_output.mp4
docs/submission/demo_thumbnail.jpg
docs/submission/DEMO_VIDEO_SCRIPT.md

