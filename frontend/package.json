{
  "name": "aurapulse-frontend",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.460.0",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.52.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.16",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
